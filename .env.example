# Notion
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Claude
ANTHROPIC_API_KEY=

# Obsidian (Zettelkasten vault)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_PROJECT_NAME=project_name          # subfolder inside vault for this project

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Target repo (the codebase the agent edits)
REPO_PATH=/path/to/local/repo

# Validation flags
SKIP_VALIDATION=false
RETRY=false
